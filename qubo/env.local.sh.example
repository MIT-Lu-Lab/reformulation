#!/usr/bin/env bash
# Copy to env.local.sh (gitignored) and edit.  Sourced at the end of env.sh,
# so plain assignments here override the defaults -- use "=", not ":=".
#
#     cp env.local.sh.example env.local.sh

# An interpreter that has jax, numpy, scipy and gurobipy.
# PRAQ_PYTHON=/path/to/.venv/bin/python

# Result archives usually belong off the repo volume.
# PRAQ_RESULTS_DIR=/scratch/$USER/praq/results

# Cluster CUDA install and the SM of the GPU you are actually targeting.
# CUDA_HOME=/usr/local/cuda-12.4
# CUDA_ARCH=90

# CUPDLPX_DIR=/home/$USER/src/cuPDLPx
